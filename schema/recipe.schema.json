{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlaschuti.cz/schema/recipe.schema.json",
  "title": "Atlas chutí – Recept",
  "description": "Jeden recept pro JSON importér (wp-content/plugins/atlas-chuti-core). Stejný formát bude v budoucnu generovat i AI modul.",
  "type": "object",
  "required": ["title", "country", "excerpt", "servings_default", "prep_minutes", "ingredients", "steps"],
  "properties": {
    "title": { "type": "string", "description": "Název receptu (český)." },
    "slug": { "type": "string", "description": "URL slug. Pokud chybí, odvodí se z title. Používá se i pro detekci duplicit." },
    "original_title": { "type": "string", "description": "Originální/cizojazyčný název." },
    "country": { "type": "string", "description": "Slug hlavní země (musí existovat mezi importovanými/existujícími zeměmi)." },
    "related_countries": { "type": "array", "items": { "type": "string" }, "description": "Slugy dalších souvisejících zemí." },
    "excerpt": { "type": "string", "description": "Krátký perex." },
    "photo_credit": { "type": "string", "description": "Zdroj/copyright fotografie (volitelné)." },
    "servings_default": { "type": "integer", "minimum": 1 },
    "prep_minutes": { "type": "integer", "minimum": 0 },
    "cook_minutes": { "type": "integer", "minimum": 0 },
    "total_minutes": { "type": "integer", "minimum": 0, "description": "Pokud chybí, dopočítá se jako prep_minutes + cook_minutes." },
    "difficulty": { "type": "string", "enum": ["Snadné", "Střední", "Náročné"] },
    "meal_type": { "type": "array", "items": { "type": "string" }, "description": "Např. [\"Hlavní jídlo\"]." },
    "diet": { "type": "array", "items": { "type": "string", "enum": ["Vegetariánské", "Veganské"] } },
    "about": { "type": "string", "description": "Krátký úvod „O receptu“. Základní HTML povoleno." },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "quantity"],
        "properties": {
          "ingredient_id": { "type": "string", "description": "Slug normalizované ingredience (volitelné vazba na atlas_ingredient)." },
          "name": { "type": "string" },
          "quantity": { "type": "string", "description": "Číslo (\"400\"), zlomek (\"1/2\"), nebo text (\"podle chuti\", \"špetka\")." },
          "unit": { "type": "string", "description": "např. g, ml, ks, lžíce, lžička." },
          "note": { "type": "string" },
          "group": { "type": "string", "description": "např. \"Hlavní\", \"Na dozdobení\"." }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "text"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" }
        }
      }
    },
    "tips": { "type": "array", "items": { "type": "string" } },
    "watch_out": { "type": "string", "description": "Na co si dát pozor." },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" }, "note": { "type": "string" } }
      }
    },
    "origin_history": { "type": "string" },
    "related_glossary": { "type": "array", "items": { "type": "string" }, "description": "Slugy pojmů ze slovníčku." },
    "related_recipes": { "type": "array", "items": { "type": "string" }, "description": "Slugy dalších receptů." },
    "seo_title": { "type": "string" },
    "meta_description": { "type": "string" },
    "status": { "type": "string", "enum": ["publish", "draft"], "default": "publish" }
  }
}
